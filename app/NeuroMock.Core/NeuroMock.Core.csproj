<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lógica pura (licença, processamento de sinal, sensor simulado, sessão), sem dependência
       de Avalonia: testável em isolamento, como o Core do produto real. -->

  <!-- Até a v2 os parâmetros do DSP vinham de um parametros.json embutido, em claro. Na v3
       (H1.2) eles saem do pacote e são decodificados em runtime de um bloco mascarado em
       ParametrosProcessamento: não há mais recurso em claro para embutir. -->

  <!-- v4: o Core entra no executável nativo (Native AOT) junto com o App. IsAotCompatible liga os
       analisadores de AOT/trimming aqui para flagrar qualquer reflexão incompatível; o Core é
       cálculo e criptografia puros (ECDSA, SHA, registro), sem reflexão, então fica limpo. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
