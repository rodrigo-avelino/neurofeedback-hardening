<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeuroMock.Views.JanelaAtivacao"
        Title="NeuroMock - Ativação"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Licença ausente, vencida ou inválida" FontSize="18" FontWeight="SemiBold" />
    <TextBlock TextWrapping="Wrap"
               Text="Coloque o arquivo licenca.json enviado pelo fornecedor na pasta do aplicativo e abra o programa de novo." />
    <Button Content="Fechar" HorizontalAlignment="Right" Click="Fechar" />
  </StackPanel>
</Window>
