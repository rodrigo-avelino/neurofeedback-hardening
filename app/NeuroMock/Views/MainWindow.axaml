<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NeuroMock.ViewModels"
        x:Class="NeuroMock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NeuroMock"
        Width="560" Height="400"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Treino de neurofeedback (sinal simulado)" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Situacao}" TextWrapping="Wrap" Opacity="0.7" />

    <TextBlock Text="Índice de engajamento" Margin="0,12,0,0" />
    <ProgressBar Minimum="0" Maximum="{x:Static vm:MainWindowViewModel.EscalaIndice}"
                 Value="{Binding IndiceNaEscala}" Height="24" />
    <TextBlock Text="{Binding TextoIndice}" />
    <TextBlock Text="Recompensa!" Foreground="ForestGreen" FontWeight="Bold" IsVisible="{Binding Recompensa}" />
    <TextBlock Text="{Binding ResumoBandas}" Opacity="0.8" />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Content="Iniciar sessão" Command="{Binding IniciarCommand}" />
      <Button Content="Encerrar sessão" Command="{Binding EncerrarCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
