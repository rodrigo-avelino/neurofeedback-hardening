{
  "name": "neurofeedback-hardening",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "dotnet tool restore",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  },
  "remoteUser": "vscode"
}
